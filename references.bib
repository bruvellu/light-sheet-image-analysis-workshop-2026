  doi = {10.1038/s41592-019-0582-9},
  pmid = {31570887},
  issn = {1548-7091,1548-7105},
  abstract = {We present ilastik, an easy-to-use interactive tool that brings
  machine-learning-based (bio)image analysis to end users without substantial
  computational expertise. It contains pre-defined workflows for image
  segmentation, object classification, counting and tracking. Users adapt the
  workflows to the problem at hand by interactively providing sparse training
  annotations for a nonlinear classifier. ilastik can process data in up to five
  dimensions (3D, time and number of channels). Its computational back end runs
  operations on-demand wherever possible, allowing for interactive prediction on
