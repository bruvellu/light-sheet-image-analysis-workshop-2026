@ARTICLE{Wolff2018-fr,
  title = {Multi-view light-sheet imaging and tracking with the MaMuT software
  reveals the cell lineage of a direct developing arthropod limb},
  author = {Wolff, Carsten and Tinevez, Jean-Yves and Pietzsch, Tobias and
  Stamataki, Evangelia and Harich, Benjamin and Guignard, Léo and Preibisch,
  Stephan and Shorte, Spencer and Keller, Philipp J and Tomancak, Pavel and
